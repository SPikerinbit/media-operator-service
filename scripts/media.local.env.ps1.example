# Copy this file to: scripts\media.local.env.ps1
# Keep secrets only in the local file and never on desktop shortcuts.

# Dify. DIFY_APP_ID is read by scripts\start_media_full_stack.ps1 to fetch the
# workflow API token from the local Dify PostgreSQL container.
$env:DIFY_APP_ID = "YOUR_DIFY_APP_ID"
$env:DIFY_API_BASE = "http://localhost"

# Operator public URL. If Dify runs in Docker, workflow HTTP nodes must call a
# host-gateway URL such as http://172.17.144.1:8090 or host.docker.internal.
$env:PUBLIC_BASE_URL = "http://localhost:8090"
$env:OPERATOR_BASE_URL = "http://172.17.144.1:8090"

$env:TRANSLATE_PROVIDER = "deepseek"
$env:TRANSLATE_API_BASE = "https://api.deepseek.com"
$env:TRANSLATE_MODEL = "deepseek-chat"
$env:TRANSLATE_API_KEY = "YOUR_DEEPSEEK_API_KEY"
$env:TRANSLATE_PROMPT_CONCURRENCY = "8"

$env:WHISPER_INFERENCE_MODE = "standard"
$env:WHISPER_VAD_ENABLED = "false"
$env:WHISPER_VAD_PADDING_MS = "800"
$env:WHISPER_BATCHED_INFERENCE = "false"
$env:WHISPER_BATCH_SIZE = "4"
$env:WHISPER_BEAM_SIZE = "5"
$env:WHISPER_BEST_OF = "5"
$env:WHISPER_CONDITION_ON_PREVIOUS_TEXT = "false"
$env:FFMPEG_BURN_ENCODER = "auto"

$env:WORKER_CONCURRENCY = "2"
$env:BATCH_WORKER_CONCURRENCY = "2"
$env:BATCH_WORKER_MAX_CONCURRENCY = "5"
$env:ALLOW_PLACEHOLDER_ARTIFACTS = "false"

$env:BILI_SESSDATA = "YOUR_BILI_SESSDATA"
$env:BILI_JCT = "YOUR_BILI_JCT"
$env:BILI_BUVID3 = "YOUR_BILI_BUVID3"
$env:BILI_DEDEUSERID = "YOUR_DEDEUSERID"
$env:BILI_AC_TIME_VALUE = "YOUR_AC_TIME_VALUE"
$env:BILI_UPLOAD_CONCURRENCY = "1"
$env:BILI_UPLOAD_LINE = "QN"
$env:BILI_UPLOAD_FALLBACK_LINES = "QN,BDA2,WS,auto"
# Optional proxy for Bilibili uploads:
# $env:BILI_PROXY = "http://127.0.0.1:7899"

$env:SUBTITLE_COHERENCE_MERGE = "true"
$env:SUBTITLE_COHERENCE_MAX_CHARS = "76"
$env:SUBTITLE_COHERENCE_MAX_DURATION_MS = "7200"
$env:SUBTITLE_COHERENCE_MAX_GAP_MS = "650"
$env:SUBTITLE_ORPHAN_MAX_CHARS = "18"

# Optional proxy for slow downloads:
# $env:http_proxy = "http://127.0.0.1:7899"
# $env:https_proxy = "http://127.0.0.1:7899"
# $env:HTTP_PROXY = "http://127.0.0.1:7899"
# $env:HTTPS_PROXY = "http://127.0.0.1:7899"
# $env:YT_DLP_PROXY = "http://127.0.0.1:7899"
# $env:YT_DLP_SOCKET_TIMEOUT = "20"
# $env:YT_DLP_RETRIES = "3"
# $env:YT_DLP_FRAGMENT_RETRIES = "3"
