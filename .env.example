# Copy to .env for the headless API or Docker Compose.
# The Windows desktop app does not read this file. It keeps settings in its
# own profile and secrets in Windows Credential Manager.
# .env is gitignored. Do not put real keys in this example.

# Data directory for jobs, batches, and preview cache. Relative paths are
# resolved from the process working directory.
MEDIA_DATA_DIR=./data
MEDIA_ROOT_DIR=.

# Public URL written into artifact links. Match the host you actually open.
PUBLIC_BASE_URL=http://127.0.0.1:8090

WORKER_CONCURRENCY=2
BATCH_WORKER_CONCURRENCY=2
BATCH_WORKER_MAX_CONCURRENCY=5

# Optional DeepSeek translation. Leave the key empty to skip translation.
TRANSLATE_PROVIDER=deepseek
TRANSLATE_API_BASE=https://api.deepseek.com
TRANSLATE_MODEL=deepseek-chat
TRANSLATE_API_KEY=

# Optional Bilibili upload cookies for the headless API.
# On the desktop app, enter these in Settings instead of this file.
BILI_SESSDATA=
BILI_JCT=
BILI_BUVID3=
BILI_DEDEUSERID=
BILI_AC_TIME_VALUE=

# Tool locations. Defaults are the executables on PATH.
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# YT_DLP_BIN=yt-dlp
# YT_DLP_PROXY=

# Desktop-only overrides used by tests and unpackaged runs.
# MEDIA_DESKTOP_HOME=
# MEDIA_DESKTOP_DATA=
# MEDIA_DESKTOP_TOOLS=
# MEDIA_DESKTOP_FONTS=
